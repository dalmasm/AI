      "source": [
        "import torch\n",
        "import os\n",
        "from transformers import AutoTokenizer, AutoModelForCausalLM, BitsAndBytesConfig\n",
        "from peft import LoraConfig, prepare_model_for_kbit_training, get_peft_model\n",
        "from trl import DPOConfig, DPOTrainer\n",
        "from datasets import load_dataset"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# --- Step 1: Choose a Lighter Model and Adjust Paths ---\n",
        "# Changed model name to Phi-3-mini-4k-instruct\n",
        "model_name = \"microsoft/Phi-3-mini-4k-instruct\"\n",
        "output_dir = \"./phi-3-mini-dpo-finetuned\" # New output directory name\n"
      ],
      "metadata": {
        "id": "7lkto6bbBwXG"
      },
      "execution_count": 38,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# --- Step 2: Load a Smaller Subset of the Dataset and Reduce Max Lengths ---\n",
        "dataset_name = \"argilla/ultrafeedback-binarized-preferences\"\n",
        "\n",
        "# Load only a small subset of the training data (e.g., first 10,000 examples)\n",
        "# This significantly reduces memory and training time for initial runs.\n",
        "preference_dataset = load_dataset(dataset_name, split=\"train[:1000]\") # Using 10,000 examples\n"
      ],
      "metadata": {
        "id": "HIVsXI-hDS-d"
      },
      "execution_count": 39,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Define the formatting function\n",
        "def format_for_dpo(example):\n",
        "    user_message = example['instruction']\n",
        "    chosen_response = example['chosen_response']\n",
        "    rejected_response = example['rejected_response']\n",
        "\n",
        "    # Phi-3 has a specific chat template that should be used\n",
        "    # The tokenizer's `apply_chat_template` handles this automatically for most models.\n",
        "    formatted_prompt = tokenizer.apply_chat_template(\n",
        "        [{\"role\": \"user\", \"content\": user_message}],\n",
        "        tokenize=False,\n",
        "        add_generation_prompt=True # Add this for the prompt part of DPO\n",
        "    )\n",
        "    formatted_chosen = tokenizer.apply_chat_template(\n",
        "        [{\"role\": \"user\", \"content\": user_message}, {\"role\": \"assistant\", \"content\": chosen_response}],\n",
        "        tokenize=False,\n",
        "        add_generation_prompt=False\n",
        "    )\n",
        "    formatted_rejected = tokenizer.apply_chat_template(\n",
        "        [{\"role\": \"user\", \"content\": user_message}, {\"role\": \"assistant\", \"content\": rejected_response}],\n",
        "        tokenize=False,\n",
        "        add_generation_prompt=False\n",
        "    )\n",
        "    return {\n",
        "        \"prompt\": formatted_prompt,\n",
        "        \"chosen\": formatted_chosen,\n",
        "        \"rejected\": formatted_rejected,\n",
        "    }"
      ],
      "metadata": {
        "id": "fYMNzbhpDV0s"
      },
      "execution_count": 40,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# --- Step 3: Set Up the Quantization and LoRA Configuration ---\n",
        "\n",
        "print(\"\\n--- Setting up Quantization and LoRA Configuration ---\")\n",
        "\n",
        "# Quantization configuration (for 4-bit loading)\n",
        "bnb_config = BitsAndBytesConfig(\n",
        "    load_in_4bit=True,\n",
        "    bnb_4bit_quant_type=\"nf4\",\n",
        "    bnb_4bit_compute_dtype=torch.bfloat16, # bfloat16 is generally better if your GPU supports it (NVIDIA Ampere architecture or newer)\n",
        "    bnb_4bit_use_double_quant=True,\n",
        ")\n",
        "\n",
        "# Load the base model in 4-bit with quantization\n",
        "model = AutoModelForCausalLM.from_pretrained(\n",
        "    model_name,\n",
        "    quantization_config=bnb_config,\n",
        "    torch_dtype=torch.bfloat16,\n",
        "    device_map=\"auto\",\n",
        "    trust_remote_code=True,\n",
        "    # attn_implementation=\"flash_attention_2\", # <-- REMOVE THIS LINE\n",
        ")\n",
        "\n",
        "# Load the tokenizer\n",
        "tokenizer = AutoTokenizer.from_pretrained(model_name, trust_remote_code=True)\n",
        "# Phi-3 tokenizer doesn't have a default pad token, so we need to set it.\n",
        "# It often uses <|endoftext|> as its EOS, which can also serve as padding.\n",
        "if tokenizer.pad_token is None:\n",
        "    tokenizer.pad_token = tokenizer.eos_token\n",
        "    tokenizer.padding_side = \"right\" # Important for training\n",
        "\n",
        "# Prepare model for k-bit training (PEFT)\n",
        "model = prepare_model_for_kbit_training(model)\n",
        "\n",
        "# LoRA configuration\n",
        "lora_config = LoraConfig(\n",
        "    r=8, # Rank of the update matrices. Lower for less memory.\n",
        "    lora_alpha=16, # Alpha parameter for LoRA scaling.\n",
        "    target_modules=[\"qkv_proj\", \"o_proj\", \"gate_up_proj\", \"down_proj\"], # Automatically identify common target modules (q_proj, k_proj, v_proj, o_proj)\n",
        "    lora_dropout=0.05, # Dropout probability for LoRA layers\n",
        "    bias=\"none\",\n",
        "    task_type=\"CAUSAL_LM\",\n",
        ")\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
