      "source": [
        "# --- Step 4: Run the DPO Training ---\n",
        "\n",
        "print(\"\\n--- Defining DPO Training Arguments and Trainer ---\")\n",
        "\n",
        "# Create output directory\n",
        "os.makedirs(output_dir, exist_ok=True)\n",
        "\n",
        "training_args = DPOConfig(\n",
        "    output_dir=output_dir,\n",
        "    per_device_train_batch_size=1, # Keep at 1 for now\n",
        "    gradient_accumulation_steps=16, # Increased accumulation steps for larger effective batch size and lower VRAM\n",
        "    gradient_checkpointing=True, # Enable for VRAM savings\n",
        "    learning_rate=5e-3,\n",
        "    num_train_epochs=1,\n",
        "    logging_steps=100,\n",
        "    save_steps=500,\n",
        "    save_total_limit=2,\n",
        "    report_to=\"tensorboard\",\n",
        "    beta=0.1,\n",
        "    max_length=256,       # Reduced from 512/1024\n",
        "    max_prompt_length=128, # Reduced from 256/512\n",
        "    # seed=42, # You can uncomment for reproducibility\n",
        ")\n",
        "\n",
        "# Initialize the DPOTrainer\n",
        "dpo_trainer = DPOTrainer(\n",
        "    model=model,\n",
        "    ref_model=ref_model,\n",
        "    args=training_args,\n",
        "    train_dataset=processed_dataset,\n",
        "     processing_class=tokenizer,\n",
        ")\n",
        "\n",
        "# Start Training!\n",
        "print(\"\\nStarting DPO training with Phi-3-mini and reduced dataset/seq length...\")\n",
        "dpo_trainer.train()\n",
        "print(\"DPO training complete!\")\n",
        "\n",
        "# --- Save the Merged Model ---\n",
        "print(f\"\\n--- Saving the final merged model to {output_dir}/final_merged_model ---\")\n",
        "final_output_dir = os.path.join(output_dir, \"final_merged_model\")\n",
        "os.makedirs(final_output_dir, exist_ok=True)\n",
        "\n",
        "# Save the adapter model and then merge it\n",
        "dpo_trainer.model.save_pretrained(final_output_dir)\n",
        "tokenizer.save_pretrained(final_output_dir)\n",
        "\n",
        "# To merge the adapters into the base model (requires sufficient CPU RAM)\n",
        "# from peft import PeftModel\n",
        "# merged_model = PeftModel.from_pretrained(model, final_output_dir)\n",
        "# merged_model = merged_model.merge_and_unload()\n",
        "# merged_model.save_pretrained(final_output_dir, safe_serialization=True)\n",
        "# tokenizer.save_pretrained(final_output_dir)\n",
        "\n",
        "print(\"Training session complete and model saved!\")\n",
        "print(\"You can load the fine-tuned model later like this:\")\n",
        "print(f\"  from transformers import AutoModelForCausalLM, AutoTokenizer\")\n",
        "print(f\"  model = AutoModelForCausalLM.from_pretrained('{final_output_dir}')\")\n",
        "print(f\"  tokenizer = AutoTokenizer.from_pretrained('{final_output_dir}')\")"
