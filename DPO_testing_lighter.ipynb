    {
      "cell_type": "code",
      "source": [
        "# Get PEFT model\n",
        "model = get_peft_model(model, lora_config)\n",
        "\n",
        "print(\"Policy Model (with QLoRA) prepared for DPO training!\")\n",
        "model.print_trainable_parameters()\n",
        "\n",
        "# --- IMPORTANT: Reference model for DPO ---\n",
        "# For DPO, you need a reference model. We'll load it similarly but without PEFT.\n",
        "# For maximal VRAM saving, we still load it in 4-bit.\n",
        "print(\"\\n--- Loading Reference Model (frozen) ---\")\n",
        "ref_model = AutoModelForCausalLM.from_pretrained(\n",
        "    model_name,\n",
        "    quantization_config=bnb_config, # Load in 4-bit for memory efficiency\n",
        "    torch_dtype=torch.bfloat16,\n",
        "    device_map=\"auto\",\n",
        "    trust_remote_code=True,\n",
        ")\n",
        "# Ensure reference model is in evaluation mode and not trainable\n",
        "ref_model.eval()\n",
        "for param in ref_model.parameters():\n",
        "    param.requires_grad = False\n",
        "print(\"Reference Model loaded and frozen.\")\n",
        "\n",
        "# --- Apply the formatting function after tokenizer is defined ---\n",
        "columns_to_remove = preference_dataset.column_names\n",
        "processed_dataset = preference_dataset.map(\n",
        "    format_for_dpo,\n",
        "    num_proc=4, # Use multiple processes for faster mapping if possible\n",
        "    remove_columns=columns_to_remove\n",
        ")\n",
        "\n",
        "print(\"\\n--- Data Preparation Complete. First Processed Example: ---\")\n",
        "print(processed_dataset[0])\n",
        "print(\"\\n--- Processed Dataset Column Names: ---\")\n",
        "print(processed_dataset.column_names)\n",
        "\n"
      ],
